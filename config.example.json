{
    "USERNAME": "admin",
    "PASSWORD": "password",
    "FIRING_TITLE": "🚨 告警触发",
    "RESOLVED_TITLE": "✅ 告警已恢复",
    "FEISHU_WEBHOOK_URL": "https://open.feishu.cn/open-apis/bot/v2/hook/xxxx",
    "FEISHU_CARD_TEMPLATE": {
        "msg_type": "interactive",
        "card": {
            "config": {
                "wide_screen_mode": true,
                "enable_forward": true
            },
            "header": {
                "template": "{card_color}",
                "title": {
                    "content": "{header_title}",
                    "tag": "plain_text"
                }
            },
            "elements": [
                {
                    "tag": "div",
                    "fields": [
                        {
                            "is_short": true,
                            "text": {
                                "tag": "lark_md",
                                "content": "**告警名称**:\n{alertname}"
                            }
                        },
                        {
                            "is_short": true,
                            "text": {
                                "tag": "lark_md",
                                "content": "**严重等级**:\n{severity}"
                            }
                        }
                    ]
                },
                {
                    "tag": "div",
                    "fields": [
                        {
                            "is_short": false,
                            "text": {
                                "tag": "lark_md",
                                "content": "**涉及实例**:\n{instance}"
                            }
                        }
                    ]
                },
                {
                    "tag": "hr"
                },
                {
                    "tag": "div",
                    "text": {
                        "tag": "lark_md",
                        "content": "**详情描述**:\n{description}"
                    }
                },
                {
                    "tag": "hr"
                },
                {
                    "tag": "note",
                    "elements": [
                        {
                            "tag": "plain_text",
                            "content": "开始时间: {start_time}"
                        }
                    ]
                }
            ]
        }
    }
}
